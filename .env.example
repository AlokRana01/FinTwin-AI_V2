# FinTwin AI — Environment Configuration Template
# Copy this file to '.env' and fill in your real values.
# Never commit '.env' to version control.

# ── Demo Account Credentials ────────────────────────────────────────────────
DEMO_EMAIL=demo@fintwin.app
DEMO_PASSWORD=Demo@123

# ── Application Base URL ────────────────────────────────────────────────────
# In development: http://localhost:8501
# In production: https://your-production-domain.com
APP_BASE_URL=http://localhost:8501

# ── SMTP Email Delivery Configuration ───────────────────────────────────────
# Configure your SMTP provider (e.g., Gmail App Password, SendGrid, AWS SES, Mailgun)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=FinTwin AI

# ── Gemini AI API Key (alternative to .streamlit/secrets.toml) ──────────────
# GEMINI_API_KEY=your_gemini_api_key_here
