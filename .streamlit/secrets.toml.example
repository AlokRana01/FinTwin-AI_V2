# .streamlit/secrets.toml.example
# FinTwin AI — Streamlit Community Cloud & Local Secrets Template
#
# FOR STREAMLIT COMMUNITY CLOUD:
# 1. Open your app dashboard on https://share.streamlit.io
# 2. Go to "Settings" -> "Secrets"
# 3. Copy & paste the contents below (with your real keys) into the TOML secrets editor.
#
# FOR LOCAL DEVELOPMENT:
# Copy this file to '.streamlit/secrets.toml' and fill in your values.
# (.streamlit/secrets.toml is ignored by git).

# ── Demo Account Credentials ─────────────────────────────────────────────────
# Seeded into the SQLite database on startup for reviewer/demo login
DEMO_EMAIL = "demo@fintwin.app"
DEMO_PASSWORD = "Demo@123"

# ── Application Base URL ─────────────────────────────────────────────────────
# Replace with your deployed Streamlit Community Cloud URL (e.g., https://your-app.streamlit.app)
APP_BASE_URL = "https://your-app-name.streamlit.app"

# ── AI Provider API Keys ─────────────────────────────────────────────────────
# Groq API key (Recommended: ultra-fast Llama-3 inference for FinBot & Financial Coach)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY = "your_groq_api_key_here"

# Google Gemini API key (Optional / alternative provider)
# Get a key at: https://aistudio.google.com/
# GEMINI_API_KEY = "your_gemini_api_key_here"

# ── SMTP Email Delivery Configuration (Optional) ─────────────────────────────
# Required only for live password resets, verification emails, and report delivery.
# Example below is for Gmail SMTP (requires an App Password with 2FA enabled):
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USERNAME = "your_email@gmail.com"
SMTP_PASSWORD = "your_16_char_app_password"
SMTP_FROM_EMAIL = "your_email@gmail.com"
SMTP_FROM_NAME = "FinTwin AI"
